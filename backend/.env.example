# Plantilla de variables de entorno del backend.
# Copia este archivo como ".env" y rellena los valores reales.
#   (en Windows PowerShell)  Copy-Item .env.example .env

# Conexión a MongoDB (local por defecto; o la URL de MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/creditos

# Clave secreta para firmar los tokens JWT (usa una cadena larga y aleatoria).
# Puedes generar una con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=pon-aqui-una-clave-larga-y-aleatoria

# Puerto en el que escucha la API
PORT=3000
